{
  "name": "asm-labs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly",
        "ms-vscode.makefile-tools",
        "ms-vscode.cpptools@1.29.3"
      ],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": true
      }
    }
  },
  "remoteUser": "vscode"
}